<main id="main">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow">STPLAYER · STREAM TRANSPORT PLAYER</p>
      <h1 id="hero-title">$hero1<br>$hero2<br><span>$hero3</span></h1>
      <p class="hero-description">$intro</p>
      <div class="hero-actions"><a class="button primary" data-apk-download href="#">$apk</a><a class="text-link" href="$latestUrl">$releaseDetails <span aria-hidden="true">↗</span></a></div>
      <p class="hero-meta" data-version-label></p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="sound-ring ring-outer"></div><div class="sound-ring ring-inner"></div>
      <svg class="soundwave" viewBox="0 0 520 200" fill="none"><path d="M10 91v18m15-27v36m15-47v58m15-80v102m15-60v18m15-49v80m15-104v128m15-160v192m15-158v124m15-91v58m15-45v32m15-49v66m15-54v42m190-46v50m15-65v80m15-125v170m15-140v110m15-77v44m15-33v22m15-38v54m15-37v20"/></svg>
      <img class="hero-icon" src="$assets/stplayer-icon.webp" width="208" height="208" alt="" fetchpriority="high">
    </div>
    <div class="hero-foot"><p>$noAds</p><a href="#features">$features <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="section wrap" id="features" aria-labelledby="features-title">
    <div class="section-heading"><h2 id="features-title">$featuresTitle</h2></div>
    <div class="feature-grid"><article class="feature"><p class="feature-label">01</p><h3>$speedTitle</h3><p>$speedBody</p></article><article class="feature"><p class="feature-label">02</p><h3>$bookmarksTitle</h3><p>$bookmarksBody</p></article><article class="feature"><p class="feature-label">03</p><h3>$sleepTitle</h3><p>$sleepBody</p></article></div>
  </section>
  <section class="library-section" aria-labelledby="library-title"><div class="wrap">
    <div class="section-heading"><h2 id="library-title">$libraryTitle</h2></div>
    <div class="mode-grid"><article class="mode"><h3>$onlineTitle</h3><p>$onlineBody</p><a class="text-link" href="$guideUrl">$guide <span aria-hidden="true">↗</span></a></article><article class="mode"><h3>$localTitle</h3><p>$localBody</p></article><article class="mode"><h3>$offlineTitle</h3><p>$offlineBody</p></article></div>
    <div class="device-grid"><div><h3>Android TV</h3><p>$tvBody</p></div><div><h3>Android Auto</h3><p>$autoBody</p></div></div>
    <p class="sync-note">$syncBody</p>
  </div></section>
  <section class="section wrap" id="download" aria-labelledby="download-title">
    <div class="download-panel"><div class="download-copy"><p class="eyebrow">$stable</p><h2 id="download-title">$downloadTitle</h2><p>$noAds</p><a class="button primary" data-apk-download href="#">$apk</a><p class="small muted" data-version-label></p><a class="text-link" href="$latestUrl">$releaseDetails <span aria-hidden="true">↗</span></a></div><div class="install-guide"><h3>$installTitle</h3><ol><li><strong>$install1Title</strong><span>$install1Body</span></li><li><strong>$install2Title</strong><span>$install2Body</span></li><li><strong>$install3Title</strong><span>$install3Body</span></li></ol></div></div>
    <div class="good-to-know"><details><summary>$updateQ</summary><p>$updateA</p></details><details><summary>$privacyQ</summary><p>$privacyA <a href="/stplayer/privacy/?lang=$lang">$privacy</a></p></details><details><summary>$booksQ</summary><p>$booksA</p></details></div>
  </section>
</main>
